  "to10": {
    "prefix": "to10",
    "body": [
      "ll to10(string s,int base){",
      "    ll res=0;",
      "    for(char c : s){",
      "        int digit;",
      "        if('0'<=c&&c<='9')",
      "            digit=c-'0';",
      "        else",
      "            digit=c-'A'+10;",
      "        res=res*base+digit;",
      "    }",
      "    return res;",
      "}"
    ]
  },
  "from10": {
    "prefix": "from10",
    "body": [
      "string from10(ll x, int base){",
      "    if(x==0) return \"0\";",
      "    string res;",
      "    while(x){",
      "        int digit=x%base;",
      "        if(digit<10)",
      "            res+=char('0'+digit);",
      "        else",
      "            res+=char('A'+digit-10);",
      "        x/=base;",
      "    }",
      "    reverse(all(res));",
      "    return res;",
      "}"
    ]
  },
  "sqrt Template": {
    "prefix": "sq",
    "body": [
      "//\u4e8c\u4e57\u3057\u3066x\u4ee5\u4e0b\u306b\u306a\u308b\u6700\u5927\u306e\u81ea\u7136\u6570",
      "ll sq(ll x){",
      "  ll y = sqrt(x);",
      "  while(y*y>x)y--;",
      "  while((y+1)*(y+1)<=x)y++;",
      "  return y;",
      "}"
        ],
  },
  "power Template": {
    "prefix": "pow",
      "body": [
        "ll powll(ll n, ll k){",
        "    ll ans = 1;",
        "    while(k > 0){",
        "        if(k & 1) ans *= n;",
        "        n *= n;",
        "        k >>= 1;",
        "    }",
        "    return ans;",
        "}"
      ]
  },
  "combination": {
    "prefix": "comb",
    "body": [
      "mint comb(int n, int k) {",
      "    if (k < 0 || k > n) return 0;",
      "    mint res = 1;",
      "    for (int i = 1; i <= k; i++) {",
      "        res *= n - i + 1;",
      "        res /= i;",
      "    }",
      "    return res;",
      "}"
    ]
  },
  "radiansort": {
    "prefix": "rasort",
    "body": [
      "    auto cmp = [](const pll &a, const pll &b) {",
      "        auto [x, y] = a;",
      "        auto [u, v] = b;",
      "",
      "        bool h = y < 0 || (y == 0 && x < 0);",
      "        bool k = v < 0 || (v == 0 && u < 0);",
      "",
      "        if (h != k) {",
      "            return h < k;",
      "        }",
      "",
      "        return x * v - y * u > 0;",
      "    };"
    ]
  },
  "center": {
    "prefix": "cent",
    "body": [
      "int cent(const vector<vi> &A){",
      "    int n=A.size();",
      "    if(n==1)return 0;",
      "",
      "    vi D(n),U(n,1);",
      "    queue<int> Q;",
      "",
      "    rep(i,n){",
      "        D[i]=A[i].size();",
      "        if(D[i]==1){",
      "            Q.push(i);",
      "            U[i]=0;",
      "        }",
      "    }",
      "",
      "    int res=-1;",
      "    while(!Q.empty()){",
      "        int a=Q.front();",
      "        Q.pop();",
      "        res=a;",
      "",
      "        for(auto x:A[a]){",
      "            if(!U[x])continue;",
      "            D[x]--;",
      "            if(D[x]==1){",
      "                Q.push(x);",
      "                U[x]=0;",
      "            }",
      "        }",
      "    }",
      "    return res;",
      "}"
    ]
  }
