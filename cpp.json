  "UnionFind Template": {
    "prefix": "uf",
    "body": [
      "vi par(1e6);",
      "int root(int x) { return par[x] == x ? x : par[x] = root(par[x]); }",
      "void unite(int x, int y) {",
      "    int rx = root(x), ry = root(y);",
      "    if (rx != ry) par[rx] = ry;",
      "}",
      "bool same(int x, int y) { return root(x) == root(y); }"
    ],
    "description": "Union-Find structure"
  },
  "Dijkstra": {
    "prefix": "di",
    "body": [
      "using P = pair<long long,int>;",
      "",
      "priority_queue<P, vector<P>, greater<P>> pq;",
      "",
      "dist[s]=0;",
      "pq.push({0,s});",
      "",
      "while(!pq.empty()){",
      "    auto [d,v]=pq.top();",
      "    pq.pop();",
      "",
      "    if(d!=dist[v]) continue;",
      "",
      "    for(auto [to,cost]: G[v]){",
      "        if(dist[to] > d + cost){",
      "            dist[to] = d + cost;",
      "            pq.push({dist[to], to});",
      "        }",
      "    }",
      "}"
    ]
  },
  "bfs": {
    "prefix": "bfs",
    "body": [
      "vi bfs(vector<vi> &A,int p){",
      "    int n=A.size();",
      "    vi res(n,-1);",
      "    queue<int>Q;",
      "    res[p]=0;",
      "    Q.push(p);",
      "    while(!Q.empty()){",
      "        int v=Q.front(); Q.pop();",
      "        for (int nv : A[v]) {",
      "            if (res[nv] != -1) continue;",
      "            res[nv]=res[v]+1;",
      "            Q.push(nv);",
      "        }",
      "    }",
      "    return res;",
      "}"
    ]
  },
